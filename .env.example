# 复制为 .env 后填写；真实邮箱/API key 不提交。
# 使用普通 KEY=value，不使用 export、变量展开或行内注释。
RSCRIPT=Rscript
LATEXMK=latexmk
LATEX_MODE=-pdf
PYTHON=python3
# 自动在隔离环境运行 BibTeX 解析器，不改系统 Python。
UV=uv
BIBTEX_PARSER=bibtexparser==1.4.3

MANUSCRIPT_MAIN=manuscript/main.tex
REFERENCES_DIR=manuscript/references
REFERENCE_BIB=manuscript/references/reference.bib

# NCBI E-utilities：无 key 自动 <=3 请求/秒，有 key 自动 <=10 请求/秒。
# key 从 NCBI 账户 Settings 获取；留空表示不使用。
NCBI_EMAIL=
NCBI_API_KEY=
NCBI_TOOL=entrez-literature-search
# auto 自动选择上限；也可设更低正数，不能超过 key 对应上限。
NCBI_REQUESTS_PER_SECOND=auto
NCBI_TIMEOUT_SECONDS=30
NCBI_MAX_RETRIES=3

# 每个章节 README 中的 pubmed 代码块各执行一次检索。无检索式则跳过。
ENTREZ_DATABASE=pubmed
ENTREZ_SORT=relevance
# 0 表示全部；超过 PubMed ESearch 的 10000 条上限会报错，须拆分检索。
ENTREZ_MAX_RECORDS=0
ENTREZ_BATCH_SIZE=100
